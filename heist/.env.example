# Export these in your shell (or your IDE's run settings). Never commit real values.
VAULT_TARGET=local
VAULT_URL=http://localhost:8088/responses
# For --target foundry
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
VAULT_AGENT_NAME=vault-keeper
# Your own vault code and passphrases (for precise leak detection and the legit checks)
VAULT_CODE=
VAULT_PASSPHRASES=
